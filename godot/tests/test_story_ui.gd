extends "res://tests/test_scene.gd"

func story_layout(caption: String) -> void:
 check_layout(caption)
 var screen := Rect2(Vector2.ZERO,root.get_visible_rect().size)
 for control in [game.story_panel,game.story_next,game.story_skip,game.story_off,game.story_highlight]:
  if control.is_visible_in_tree(): check(screen.encloses(control.get_global_rect()),caption+" story control fits: "+control.name)
 if game.story_panel.visible:
  for control in [game.action_button,game.selection_panel,game.patient_button,game.outside_button,game.pause_button,game.next_day_button]:
   if control.is_visible_in_tree(): check(not game.story_panel.get_global_rect().intersects(control.get_global_rect()),caption+" does not cover "+control.name)
  check(game.story_text.get_line_count() <= 4,caption+" dialogue fits the compact text area")
  for p in game.sim.patients:
   if p.state in ["waiting","plan_ready","ct_scan"]:
    var actor: HospitalActor = game.world.actors[p.id]
    var point: Vector2 = game.world.camera.unproject_position(actor.head.global_position)*game.size/Vector2(game.viewport.size)
    check(not game.story_panel.get_global_rect().grow(8).has_point(point),caption+" keeps patient face visible: "+str(p.id))

func run() -> void:
 for arg in OS.get_cmdline_user_args():
  if arg.begins_with("--output-dir="): output = arg.trim_prefix("--output-dir=")
 root.size = Vector2i(1280,720)
 game = load("res://main.tscn").instantiate()
 root.add_child(game)
 game.set_process(false)
 await settle()
 game.refresh()
 check(game.story.active == "welcome","welcome in real engine")
 story_layout("welcome")
 await shot("01-welcome")
 var center: Vector3 = game.world.view_center
 var zoom: float = game.world.camera.size
 await click(game.story_next)
 check(game.story.line == 1 and not game.sim.paused,"real next button leaves simulation running")
 await click(game.story_skip)
 check(center.distance_to(game.world.view_center) < .01 and absf(zoom-game.world.camera.size) < .001,"dialogue next and skip keep the operating camera unchanged")
 game.sim.tick(6); game.refresh()
 check(game.story.active == "arrival","patient arrival scene")
 await shot("02-arrival")
 await click(game.patient_button); game.refresh()
 check(game.roster.visible and not game.story_panel.visible,"roster remains clear during dialogue")
 await click(game.rows[0])
 check(game.selected_id == 1 and game.sim.get_patient(1).state == "waiting","real roster selection is separate from admission")
 story_layout("admission")
 await shot("03-admission")
 await click(game.action_button)
 check(game.sim.get_patient(1).state == "walk_ct" and game.story.active == "ct","early action advances state and replaces outdated guidance")
 while game.sim.get_patient(1).state != "ct_scan": game.sim.tick(.1)
 game.refresh(); await settle()
 story_layout("CT")
 await shot("04-ct")
 while game.sim.get_patient(1).state != "plan_ready": game.sim.tick(.1)
 game.refresh()
 check(game.story.active == "plan","plan scene is state-driven")
 await shot("04-plan")
 await click(game.action_button)
 while game.sim.get_patient(1).state != "treatment": game.sim.tick(.1)
 game.refresh(); await settle()
 check(game.story.active == "treatment","treatment scene uses existing service")
 story_layout("treatment")
 await shot("05-treatment")
 while not game.sim.get_patient(1).paid: game.sim.tick(.1)
 game.refresh()
 check(game.story.active == "complete" and game.sim.money == 1100,"completion story follows exactly one fee")
 await shot("06-completion")
 await click(game.story_skip)
 check(game.story.active == "expansion","optional expansion invitation follows completion")
 story_layout("expansion")
 await shot("07-expansion-hint")
 await click(game.outside_button)
 check(game.outside and not game.story_panel.visible and game.sim.paused,"outside pauses without dialogue overlay")
 await shot("08-expansion-site")
 await click(game.expansion_button)
 check(game.confirmation.visible,"real expansion confirmation opens")
 await click(game.confirmation.get_ok_button())
 check(game.sim.expanded and game.sim.money == 500,"player purchase keeps existing 600 cost")
 await click(game.outside_button)
 check(not game.sim.paused,"return restores running intent")
 for step in range(3000):
  for p in game.sim.patients:
   if p.state == "waiting": game.sim.admit(p.id)
   elif p.state == "plan_ready": game.sim.assign_plan(p.id)
  game.sim.tick(.1)
  if game.sim.all_done(): break
 game.refresh()
 check(game.story.active == "day_end" and game.sim.money == 1100 and game.sim.max_treating == 2,"two-room first day ends with original economy")
 story_layout("day end")
 await shot("09-day-end")
 await click(game.next_day_button)
 game.sim.tick(7); game.refresh()
 check(game.sim.day == 2 and not game.story_panel.visible and not game.story_off.visible,"real next-day button retires all first-day UI")
 await shot("10-day-two")
 # A fresh compact landscape window tests the actual visible tutorial layout.
 game.free()
 root.size = Vector2i(844,390)
 game = load("res://main.tscn").instantiate()
 root.add_child(game); game.set_process(false)
 await settle(); game.refresh(); await settle()
 story_layout("compact landscape")
 await shot("11-compact-welcome")
 await click(game.story_off)
 check(not game.story.enabled and not game.story_panel.visible and not game.sim.paused,"real guide-off button leaves operation available")
 var result := {"passed":failures.is_empty(),"checks":checks,"failures":failures,"automatic_input":true,"renderer":"Godot Compatibility / Linux llvmpipe","mobile_hardware_test":false,"initial_camera_size":zoom}
 FileAccess.open(output.path_join("results.json"),FileAccess.WRITE).store_string(JSON.stringify(result,"  "))
 print("STORY UI: ",JSON.stringify(result))
 quit(0 if failures.is_empty() else 1)
