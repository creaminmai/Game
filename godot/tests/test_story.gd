extends SceneTree
const Sim = preload("res://scripts/hospital_simulation.gd")
const Story = preload("res://scripts/first_day_story.gd")
const Store = preload("res://scripts/save_store.gd")
var checks := 0
var failures: Array[String] = []
var saved_stages: Array[String] = []

func check(ok: bool, caption: String) -> void:
 checks += 1
 if not ok: failures.append(caption); printerr("FAIL: ",caption)

func roundtrip(sim: HospitalSimulation, story: FirstDayStory) -> void:
 var store := Store.new()
 store.path = "user://test-story.json"
 var a := sim.snapshot()
 var b := story.snapshot()
 check(store.save(sim,story),"save story at "+story.active)
 var copy := Sim.new()
 var restored := Story.new()
 check(store.load_into(copy,restored),"restore story at "+story.active)
 check(JSON.stringify(copy.snapshot()) == JSON.stringify(a) and JSON.stringify(restored.snapshot()) == JSON.stringify(b),"exact serialized operational and dialogue round trip: "+story.active)
 var id := story.active
 restored.sync(copy,1 if restored.selected_first else -1)
 check(restored.active == id,"restored current dialogue is not restarted: "+id)
 saved_stages.append(id)
 DirAccess.remove_absolute(store.path)

func autoplay(sim: HospitalSimulation, story: FirstDayStory, expand: bool) -> void:
 for n in range(4000):
  story.sync(sim,1)
  story.finish_dialogue()
  for p in sim.patients:
   if p.state == "waiting": sim.admit(p.id)
   elif p.state == "plan_ready": sim.assign_plan(p.id)
  if expand and sim.expansion_reason().is_empty(): sim.purchase_expansion()
  sim.tick(.1)
  if sim.all_done(): return

func run() -> void:
 var sim := Sim.new()
 var story := Story.new()
 story.sync(sim,-1)
 check(story.active == "welcome" and sim.money == 900,"new game opens welcome without economic changes")
 story.next_line(sim)
 roundtrip(sim,story)
 story.finish_dialogue()
 sim.tick(6)
 story.sync(sim,-1)
 check(story.active == "arrival" and sim.get_patient(1).state == "waiting","actual arrival triggers patient story")
 roundtrip(sim,story)
 story.finish_dialogue(); story.sync(sim,-1)
 check(story.active == "" and story.hint(sim,-1,false).contains("선택"),"action hint replaces dialogue while awaiting selection")
 sim.tick(12); story.sync(sim,-1)
 check(story.stage == "select" and not sim.get_patient(1).history.has("ct_queue"),"elapsed time cannot complete selection or admission")
 story.sync(sim,1)
 check(story.active == "admission" and sim.get_patient(1).state == "waiting","selection remains separate from admission")
 roundtrip(sim,story)
 check(sim.admit(1),"player admission succeeds")
 story.sync(sim,1)
 check(story.active == "ct" and story.seen.admission,"early action retires stale reception dialogue")
 roundtrip(sim,story)
 while sim.get_patient(1).state != "plan_ready": sim.tick(.1)
 story.sync(sim,1)
 check(story.active == "plan" and story.seen.ct,"plan instruction only after actual CT and travel")
 roundtrip(sim,story)
 check(sim.assign_plan(1),"actual plan request succeeds")
 story.sync(sim,1)
 check(story.active != "plan","started plan is never requested again")
 while sim.get_patient(1).state != "treatment": sim.tick(.1)
 story.sync(sim,1)
 check(story.active == "treatment","treatment story follows actual equipment service")
 roundtrip(sim,story)
 while not sim.get_patient(1).paid: sim.tick(.1)
 story.sync(sim,1)
 check(story.active == "complete" and sim.money == 1100 and sim.completed() == 1,"first completion follows original single payment")
 roundtrip(sim,story)
 story.finish_dialogue(); story.sync(sim,1)
 check(story.active == "expansion" and not sim.expanded,"expansion invitation cannot buy or move")
 roundtrip(sim,story)
 for n in range(20): story.next_line(sim); story.sync(sim,1)
 check(sim.money == 1100 and sim.completed() == 1 and not sim.expanded,"rapid dialogue clicks never pay or buy")
 autoplay(sim,story,false)
 story.sync(sim,1)
 check(sim.all_done() and sim.money == 1700 and not sim.expanded,"day one completes with expansion deferred")
 check(story.active == "day_end" and story.day_summary(sim).contains("800만"),"actual four returned patients and fee summary trigger ending")
 roundtrip(sim,story)
 var balance := sim.money
 story.finish_dialogue(); story.sync(sim,1)
 check(story.active == "" and sim.money == balance,"ending has no bonus or repeated scene")
 check(sim.start_next_day(),"existing next-day action still works")
 story.sync(sim,-1); sim.tick(20); story.sync(sim,1)
 check(story.active == "" and story.hint(sim,1,false) == "","no first-day dialogue or hint on day two")
 for mode in ["off","skip","ahead"]:
  var s := Sim.new()
  var t := Story.new()
  if mode == "off": t.disable()
  if mode == "ahead":
   s.tick(6); s.admit(1); s.tick(30)
  autoplay(s,t,true)
  t.sync(s,1)
  check(s.all_done() and s.expanded and s.max_treating == 2 and s.money == 1100,"complete two-room day with "+mode)
  check(s.lifetime_completed == 4,"one fee per patient with "+mode)
  if mode == "off":
   check(t.active == "" and not t.enabled,"disable remains off throughout day")
   roundtrip(s,t)
 var legacy := Store.new()
 legacy.path = "user://test-story-legacy.json"
 var ongoing := Sim.new()
 ongoing.tick(6); ongoing.admit(1); ongoing.tick(2)
 legacy.save(ongoing)
 var legacy_bytes := FileAccess.get_file_as_string(legacy.path)
 var old_story := Story.new()
 check(legacy.load_into(Sim.new(),old_story) and not old_story.enabled,"v2 save without story is preserved and not enrolled")
 check(FileAccess.get_file_as_string(legacy.path) == legacy_bytes,"loading a legacy first-day save never rewrites its bytes")
 var invalid := sim.snapshot()
 invalid.first_day_story = {"version":999}
 FileAccess.open(legacy.path,FileAccess.WRITE).store_string(JSON.stringify(invalid))
 var untouched := Sim.new()
 var before := untouched.snapshot()
 check(not legacy.load_into(untouched,Story.new()) and legacy.blocked and untouched.snapshot() == before,"invalid story metadata cannot partially restore simulation")
 check(not legacy.save(untouched) and FileAccess.get_file_as_string(legacy.path) == JSON.stringify(invalid),"unknown story save remains untouched")
 DirAccess.remove_absolute(legacy.path)
 # Main-scene integration: independent pause holds and UI controls.
 var game = load("res://main.tscn").instantiate()
 root.add_child(game)
 game.set_process(false)
 await process_frame
 game.refresh()
 check(game.story.active == "welcome" and game.story_panel.visible,"actual scene renders welcome")
 game.toggle_pause()
 game.advance_story(); game.skip_story()
 check(game.sim.paused,"dialogue next/skip preserves user pause")
 game.toggle_outside(); game.set_pause_hold("application",true); game.toggle_outside()
 check(game.sim.paused,"application hold survives outside return")
 game.set_pause_hold("application",false)
 check(game.sim.paused,"application resume preserves prior user pause")
 game.toggle_pause()
 check(not game.sim.paused,"explicit play releases player pause")
 game.set_pause_hold("application",true); game.toggle_outside(); game.set_pause_hold("application",false)
 check(game.sim.paused,"outside hold survives application resume")
 game.toggle_outside()
 check(not game.sim.paused,"return releases final temporary hold")
 game._notification(NOTIFICATION_APPLICATION_FOCUS_OUT)
 game._notification(NOTIFICATION_APPLICATION_PAUSED)
 game._notification(NOTIFICATION_APPLICATION_FOCUS_IN)
 check(game.sim.paused,"focus return cannot release the separate app-background hold")
 game._notification(NOTIFICATION_APPLICATION_RESUMED)
 check(not game.sim.paused,"application resume releases the final background hold")
 game.sim.tick(6); game.refresh(); game.select_patient(1)
 check(game.sim.get_patient(1).state == "waiting","UI selection does not admit")
 game.perform_action(); game.perform_action()
 check(game.sim.get_patient(1).history.count("ct_queue") == 1,"double input cannot register same admission")
 game.disable_story()
 check(not game.story_panel.visible and not game.story_highlight.visible and not game.sim.paused,"turning guidance off leaves normal operation running")
 game.free()
 var output := ProjectSettings.globalize_path("res://../artifacts/story-unit")
 DirAccess.make_dir_recursive_absolute(output)
 var result := {"passed":failures.is_empty(),"checks":checks,"failures":failures,"saved_scenes":saved_stages,"mac_or_mobile_hardware_test":false}
 FileAccess.open(output.path_join("results.json"),FileAccess.WRITE).store_string(JSON.stringify(result,"  "))
 print("STORY: ",JSON.stringify(result))
 quit(0 if failures.is_empty() else 1)

func _initialize() -> void:
 run.call_deferred()
