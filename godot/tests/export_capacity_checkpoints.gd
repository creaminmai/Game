extends SceneTree
const Fixture = preload("res://tests/daily_capacity_fixture.gd")
func write(sim: HospitalSimulation, name_text: String) -> void:
 var story := FirstDayStory.new(); story.disable()
 var store := HospitalSaveStore.new(); store.path = "res://../artifacts/capacity-web-checkpoints/"+name_text+".json"
 assert(store.save(sim,story))
func _initialize() -> void:
 DirAccess.make_dir_recursive_absolute("res://../artifacts/capacity-web-checkpoints")
 var sim := Fixture.first_journal()
 sim.set_admission_delegated(false)
 write(sim,"journal")
 assert(sim.start_next_day(6)); sim.tick(40)
 write(sim,"waiting")
 Fixture.finish(sim); write(sim,"closed-six")
 print("CAPACITY WEB: three checkpoints generated by real commands and elapsed simulation")
 quit()
