config_version=5

[application]
config/name="햇살병원"
config/version="0.4.0-dev"
config/icon="res://assets/ui/portrait-minji.png"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=2
lights_and_shadows/directional_shadow/16_bits=false
environment/defaults/default_clear_color=Color(0.94,0.93,0.88,1)

[input_devices]
pointing/emulate_mouse_from_touch=true
